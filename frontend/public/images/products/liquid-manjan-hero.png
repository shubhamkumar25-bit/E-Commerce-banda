<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800" fill="none">
  <defs>
    <radialGradient id="liqBg" cx="50%" cy="50%" r="55%">
      <stop offset="0%" stop-color="#FFFFFF" />
      <stop offset="45%" stop-color="#F7F3E8" />
      <stop offset="100%" stop-color="#DCE7D9" />
    </radialGradient>
    <linearGradient id="goldDrop" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFE082" />
      <stop offset="40%" stop-color="#C7A45B" />
      <stop offset="100%" stop-color="#8D6E26" />
    </linearGradient>
    <filter id="splashGlow" x="-30%" y="-30%" width="160%" height="160%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#C7A45B" flood-opacity="0.4" />
    </filter>
  </defs>

  <rect width="800" height="800" fill="url(#liqBg)" />

  <!-- Dynamic Liquid Splash Ring (Demonstrating Pure Liquid Manjan) -->
  <g transform="translate(400, 480)" filter="url(#splashGlow)">
    <ellipse cx="0" cy="0" rx="260" ry="45" fill="none" stroke="url(#goldDrop)" stroke-width="4" stroke-dasharray="8 4" opacity="0.6" />
    <!-- Splash crowns -->
    <path d="M-180 -10 Q-160 -60 -140 -20" stroke="url(#goldDrop)" stroke-width="3" fill="none" stroke-linecap="round" />
    <path d="M140 -15 Q170 -70 190 -10" stroke="url(#goldDrop)" stroke-width="3" fill="none" stroke-linecap="round" />
    <circle cx="-160" cy="-65" r="5" fill="url(#goldDrop)" />
    <circle cx="170" cy="-75" r="6" fill="url(#goldDrop)" />
  </g>

  <!-- Giant Golden Liquid Manjan Droplet Falling -->
  <g transform="translate(400, 260)" filter="url(#splashGlow)">
    <path d="M0 -80 C-45 0 -70 50 -70 100 C-70 145 -38 180 0 180 C38 180 70 145 70 100 C70 50 45 0 0 -80 Z" fill="url(#goldDrop)" />
    <!-- Light Highlight on Droplet -->
    <ellipse cx="-20" cy="80" rx="14" ry="35" fill="#FFFFFF" opacity="0.5" transform="rotate(-15 -20 80)" />
    <!-- Botanical Vein inside Liquid Droplet -->
    <path d="M0 -40 L0 140" stroke="#103A29" stroke-width="3" stroke-linecap="round" opacity="0.8" />
    <path d="M0 20 Q20 35 30 50" stroke="#103A29" stroke-width="2.5" stroke-linecap="round" opacity="0.8" />
    <path d="M0 60 Q-20 75 -28 90" stroke="#103A29" stroke-width="2.5" stroke-linecap="round" opacity="0.8" />
  </g>

  <!-- Typography overlay -->
  <text x="400" y="600" font-family="'Cinzel', serif" font-size="26" font-weight="800" fill="#174D35" text-anchor="middle" letter-spacing="3">100% LIQUID FORMULATION</text>
  <text x="400" y="635" font-family="'Plus Jakarta Sans', sans-serif" font-size="13" font-weight="700" fill="#C7A45B" text-anchor="middle" letter-spacing="2">ZERO ABRASION • INSTANT BOTANICAL ABSORPTION</text>
  <text x="400" y="665" font-family="'Plus Jakarta Sans', sans-serif" font-size="11" font-weight="600" fill="#4B6354" text-anchor="middle">Crafted with Pure Herbal Extracts in Banda, UP</text>
</svg>

