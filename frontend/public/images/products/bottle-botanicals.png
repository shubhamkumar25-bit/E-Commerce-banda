<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800" fill="none">
  <defs>
    <radialGradient id="botBg" cx="50%" cy="50%" r="60%">
      <stop offset="0%" stop-color="#FFFFFF" />
      <stop offset="50%" stop-color="#F2ECE0" />
      <stop offset="100%" stop-color="#E2ECE0" />
    </radialGradient>
    <linearGradient id="goldB" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FCEAB3" />
      <stop offset="50%" stop-color="#C7A45B" />
      <stop offset="100%" stop-color="#916E25" />
    </linearGradient>
    <linearGradient id="leafGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#4CAF50" />
      <stop offset="100%" stop-color="#1B5E20" />
    </linearGradient>
    <filter id="botShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="18" stdDeviation="22" flood-color="#103A29" flood-opacity="0.2" />
    </filter>
  </defs>

  <rect width="800" height="800" fill="url(#botBg)" />

  <!-- Botanical Herb Leaves Spread in Background -->
  <!-- Big Neem/Babool Fronds -->
  <g opacity="0.85">
    <path d="M50 200 C150 150 240 220 300 160 C260 260 160 300 50 200 Z" fill="#2E7D4E" />
    <path d="M750 480 C650 400 580 500 500 450 C540 560 640 600 750 480 Z" fill="#388E3C" />
  </g>

  <!-- Ground Herbal Platform / Wooden Tray Shadow -->
  <ellipse cx="400" cy="710" rx="280" ry="40" fill="#E8DEC9" />
  <ellipse cx="400" cy="705" rx="200" ry="25" fill="#103A29" opacity="0.18" />

  <!-- Center GIWANSALLY Liquid Manjan Bottle -->
  <g transform="translate(310, 160) scale(0.9)" filter="url(#botShadow)">
    <!-- Dropper -->
    <path d="M100 70 C100 35 110 20 120 20 C130 20 140 35 140 70 Z" fill="#15261C" />
    <rect x="90" y="70" width="60" height="45" rx="4" fill="url(#goldB)" />
    <rect x="75" y="115" width="90" height="25" rx="4" fill="url(#goldB)" />
    <!-- Bottle Body -->
    <path d="M75 140 C40 160 10 200 5 260 L5 580 C5 605 25 620 55 620 L185 620 C215 620 235 605 235 580 L235 260 C230 200 200 160 165 140 Z" fill="#1A4A32" />
    <!-- Label -->
    <rect x="25" y="250" width="190" height="310" rx="8" fill="#FBF8F1" stroke="url(#goldB)" stroke-width="2" />
    <text x="120" y="320" font-family="'Cinzel', serif" font-size="18" font-weight="800" fill="#174D35" text-anchor="middle">GIWANSALLY</text>
    <text x="120" y="340" font-family="'Plus Jakarta Sans', sans-serif" font-size="8.5" font-weight="700" fill="#C7A45B" text-anchor="middle">AYURVEDIC LIQUID MANJAN</text>
    <rect x="40" y="360" width="160" height="40" rx="4" fill="#E9F0E7" />
    <text x="120" y="384" font-family="'Plus Jakarta Sans', sans-serif" font-size="8" font-weight="700" fill="#103A29" text-anchor="middle">BOTANICAL HERB INFUSION</text>
    <text x="120" y="440" font-family="'Cinzel', serif" font-size="12" font-weight="700" fill="#103A29" text-anchor="middle">100 ML • BANDA, UP</text>
  </g>

  <!-- FOREGROUND BOTANICAL HERBS & SPICES -->
  <!-- Fresh Cloves (Laung) -->
  <g transform="translate(180, 580)">
    <circle cx="40" cy="40" r="16" fill="#4E3120" stroke="#331E12" stroke-width="2" />
    <circle cx="40" cy="38" r="9" fill="#75482F" />
    <path d="M36 54 L32 105 C32 108 48 108 48 105 L44 54 Z" fill="#3D2416" />
    <text x="40" y="130" font-family="'Plus Jakarta Sans', sans-serif" font-size="11" font-weight="700" fill="#103A29" text-anchor="middle">Laung (Clove)</text>
  </g>

  <!-- Babool Bark Sticks -->
  <g transform="translate(520, 570) rotate(-10)">
    <rect x="0" y="0" width="140" height="28" rx="6" fill="#6B4828" stroke="#482F18" stroke-width="2" />
    <line x1="20" y1="14" x2="120" y2="14" stroke="#482F18" stroke-width="2" stroke-dasharray="8 6" />
    <text x="70" y="55" font-family="'Plus Jakarta Sans', sans-serif" font-size="11" font-weight="700" fill="#103A29" text-anchor="middle">Babool Bark</text>
  </g>

  <!-- Fresh Spearmint / Pudina Leaves -->
  <g transform="translate(480, 640)">
    <path d="M0 40 C30 15 60 5 90 0 C75 30 50 55 0 40 Z" fill="url(#leafGrad)" />
    <path d="M0 40 Q45 20 90 0" stroke="#A5D6A7" stroke-width="1.5" />
    <text x="45" y="70" font-family="'Plus Jakarta Sans', sans-serif" font-size="11" font-weight="700" fill="#103A29" text-anchor="middle">Pudina Satva</text>
  </g>

  <!-- Floating Droplets of Ayurvedic Liquid Essence -->
  <g>
    <circle cx="280" cy="380" r="8" fill="url(#goldB)" opacity="0.8" />
    <circle cx="278" cy="378" r="2.5" fill="#FFFFFF" />
    <circle cx="530" cy="340" r="10" fill="url(#goldB)" opacity="0.8" />
    <circle cx="527" cy="337" r="3" fill="#FFFFFF" />
  </g>
</svg>

