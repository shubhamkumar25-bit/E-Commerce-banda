<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800" fill="none">
  <defs>
    <radialGradient id="frontGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#FFFFFF" />
      <stop offset="60%" stop-color="#F8F4E9" />
      <stop offset="100%" stop-color="#E9F0E7" />
    </radialGradient>
    <linearGradient id="goldM" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F5E8BA" />
      <stop offset="40%" stop-color="#C7A45B" />
      <stop offset="100%" stop-color="#8E6F28" />
    </linearGradient>
    <linearGradient id="bottleGreen" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#14432C" />
      <stop offset="35%" stop-color="#286948" />
      <stop offset="70%" stop-color="#174A31" />
      <stop offset="100%" stop-color="#0F3320" />
    </linearGradient>
    <filter id="shadowF" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="20" stdDeviation="24" flood-color="#103A29" flood-opacity="0.25" />
    </filter>
  </defs>

  <rect width="800" height="800" fill="url(#frontGlow)" />
  <ellipse cx="400" cy="730" rx="170" ry="22" fill="#103A29" opacity="0.22" />

  <!-- FRONT BOTTLE PACKAGING -->
  <g filter="url(#shadowF)">
    <!-- Dropper Bulb & Pipette -->
    <path d="M380 90 C380 50 390 35 400 35 C410 35 420 50 420 90 Z" fill="#15261C" />
    <rect x="370" y="90" width="60" height="50" rx="4" fill="url(#goldM)" />
    <rect x="350" y="140" width="100" height="30" rx="5" fill="url(#goldM)" />
    <rect x="345" y="166" width="110" height="12" rx="3" fill="url(#goldM)" />

    <!-- Glass Bottle -->
    <path d="M350 178 C310 196 275 240 270 300 L270 680 C270 705 295 725 325 725 L475 725 C505 725 530 705 530 680 L530 300 C525 240 490 196 450 178 Z" fill="url(#bottleGreen)" />
    <!-- Glass gloss highlight -->
    <path d="M285 295 L285 680" stroke="#FFFFFF" stroke-width="6" stroke-linecap="round" opacity="0.4" />

    <!-- Detailed Center Product Label -->
    <rect x="290" y="305" width="220" height="360" rx="10" fill="#FBF8F1" stroke="url(#goldM)" stroke-width="2.5" />
    <rect x="298" y="313" width="204" height="344" rx="7" fill="none" stroke="url(#goldM)" stroke-width="1.2" stroke-dasharray="5 3" />

    <!-- Brand Emblem -->
    <circle cx="400" cy="350" r="18" fill="#103A29" stroke="url(#goldM)" stroke-width="1.5" />
    <path d="M400 338 C395 344 391 350 391 355 C391 360 395 363 400 363 C405 363 409 360 409 355 C409 350 405 344 400 338 Z" fill="url(#goldM)" />

    <text x="400" y="394" font-family="'Cinzel', serif" font-size="22" font-weight="800" fill="#174D35" text-anchor="middle" letter-spacing="2.5">GIWANSALLY</text>
    <text x="400" y="414" font-family="'Plus Jakarta Sans', sans-serif" font-size="9" font-weight="700" fill="#C7A45B" text-anchor="middle" letter-spacing="3">TRADITIONAL AYURVEDIC FORMULA</text>

    <line x1="330" y1="428" x2="470" y2="428" stroke="url(#goldM)" stroke-width="1.5" />

    <text x="400" y="452" font-family="'Cinzel', serif" font-size="14" font-weight="700" fill="#C7A45B" text-anchor="middle" letter-spacing="1">PREMIUM AYURVEDIC</text>
    <text x="400" y="474" font-family="'Cinzel', serif" font-size="16" font-weight="800" fill="#103A29" text-anchor="middle" letter-spacing="1.5">LIQUID MANJAN</text>

    <!-- Key Ingredients Pill -->
    <rect x="315" y="492" width="170" height="52" rx="6" fill="#E9F0E7" />
    <text x="400" y="512" font-family="'Plus Jakarta Sans', sans-serif" font-size="8.5" font-weight="700" fill="#174D35" text-anchor="middle">ACTIVE BOTANICALS</text>
    <text x="400" y="528" font-family="'Plus Jakarta Sans', sans-serif" font-size="8" font-weight="600" fill="#4B6354" text-anchor="middle">Clove Oil • Babool • Bakul</text>

    <!-- Highlights -->
    <text x="400" y="568" font-family="'Plus Jakarta Sans', sans-serif" font-size="9" font-weight="600" fill="#103A29" text-anchor="middle">Non-Abrasive Enamel Protection</text>
    <text x="400" y="586" font-family="'Plus Jakarta Sans', sans-serif" font-size="8.5" font-weight="500" fill="#4B6354" text-anchor="middle">Formulated in Banda, Uttar Pradesh</text>

    <!-- Volume & Badge -->
    <rect x="325" y="605" width="150" height="30" rx="15" fill="#103A29" />
    <text x="365" y="624" font-family="'Cinzel', serif" font-size="11" font-weight="700" fill="#FFFFFF" text-anchor="middle">100 ML</text>
    <line x1="395" y1="610" x2="395" y2="630" stroke="url(#goldM)" stroke-width="1.2" />
    <text x="435" y="624" font-family="'Plus Jakarta Sans', sans-serif" font-size="8.5" font-weight="700" fill="#E5C778" text-anchor="middle">ESTD. BANDA</text>
  </g>
</svg>

