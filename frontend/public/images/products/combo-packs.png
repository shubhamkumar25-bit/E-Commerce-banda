<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800" fill="none">
  <defs>
    <radialGradient id="comboBg" cx="50%" cy="50%" r="55%">
      <stop offset="0%" stop-color="#FFFFFF" />
      <stop offset="50%" stop-color="#F8F4E9" />
      <stop offset="100%" stop-color="#E5EDE3" />
    </radialGradient>
    <linearGradient id="goldC" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F5E8BA" />
      <stop offset="40%" stop-color="#C7A45B" />
      <stop offset="100%" stop-color="#8E6F28" />
    </linearGradient>
    <filter id="packShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="18" stdDeviation="20" flood-color="#103A29" flood-opacity="0.22" />
    </filter>
  </defs>

  <rect width="800" height="800" fill="url(#comboBg)" />
  <ellipse cx="400" cy="720" rx="300" ry="30" fill="#103A29" opacity="0.18" />

  <!-- Premium Gift Box Silhouette in Background -->
  <rect x="220" y="240" width="360" height="460" rx="12" fill="#103A29" stroke="url(#goldC)" stroke-width="3" />
  <rect x="230" y="250" width="340" height="440" rx="8" fill="none" stroke="url(#goldC)" stroke-width="1.2" stroke-dasharray="6 3" />
  <text x="400" y="295" font-family="'Cinzel', serif" font-size="16" font-weight="700" fill="#E5C778" text-anchor="middle" letter-spacing="3">GIWANSALLY AYURVEDA</text>
  <text x="400" y="320" font-family="'Plus Jakarta Sans', sans-serif" font-size="9" font-weight="600" fill="#C7A45B" text-anchor="middle" letter-spacing="2">HERBAL DUO VALUE PACK</text>

  <!-- Bottle 1 (Left) -->
  <g transform="translate(240, 260) scale(0.85)" filter="url(#packShadow)">
    <path d="M70 60 C70 30 78 15 86 15 C94 15 102 30 102 60 Z" fill="#15261C" />
    <rect x="64" y="60" width="44" height="35" rx="3" fill="url(#goldC)" />
    <rect x="52" y="95" width="68" height="20" rx="3" fill="url(#goldC)" />
    <path d="M52 115 C28 130 6 165 2 210 L2 450 C2 470 18 482 42 482 L132 482 C156 482 172 470 172 450 L172 210 C168 165 146 130 120 115 Z" fill="#1C5537" />
    <rect x="18" y="200" width="138" height="230" rx="6" fill="#FBF8F1" stroke="url(#goldC)" stroke-width="1.5" />
    <text x="86" y="246" font-family="'Cinzel', serif" font-size="12" font-weight="800" fill="#174D35" text-anchor="middle">GIWANSALLY</text>
    <text x="86" y="262" font-family="'Plus Jakarta Sans', sans-serif" font-size="6.5" font-weight="700" fill="#C7A45B" text-anchor="middle">CLASSIC 100ML</text>
  </g>

  <!-- Bottle 2 (Right) -->
  <g transform="translate(410, 260) scale(0.85)" filter="url(#packShadow)">
    <path d="M70 60 C70 30 78 15 86 15 C94 15 102 30 102 60 Z" fill="#15261C" />
    <rect x="64" y="60" width="44" height="35" rx="3" fill="url(#goldC)" />
    <rect x="52" y="95" width="68" height="20" rx="3" fill="url(#goldC)" />
    <path d="M52 115 C28 130 6 165 2 210 L2 450 C2 470 18 482 42 482 L132 482 C156 482 172 470 172 450 L172 210 C168 165 146 130 120 115 Z" fill="#17462D" />
    <rect x="18" y="200" width="138" height="230" rx="6" fill="#FBF8F1" stroke="url(#goldC)" stroke-width="1.5" />
    <text x="86" y="246" font-family="'Cinzel', serif" font-size="12" font-weight="800" fill="#174D35" text-anchor="middle">GIWANSALLY</text>
    <text x="86" y="262" font-family="'Plus Jakarta Sans', sans-serif" font-size="6.5" font-weight="700" fill="#C7A45B" text-anchor="middle">GUM DEFENCE 100ML</text>
  </g>

  <!-- Value Banner Badge -->
  <g transform="translate(400, 680)">
    <rect x="-140" y="-20" width="280" height="40" rx="20" fill="url(#goldC)" />
    <text x="0" y="5" font-family="'Cinzel', serif" font-size="13" font-weight="800" fill="#103A29" text-anchor="middle" letter-spacing="1.5">SAVE 25% • 2X VALUE PACK</text>
  </g>
</svg>

