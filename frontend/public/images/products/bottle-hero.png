<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800" fill="none">
  <defs>
    <!-- Background Gradients -->
    <radialGradient id="bgGlow" cx="50%" cy="45%" r="65%">
      <stop offset="0%" stop-color="#FFFFFF" />
      <stop offset="40%" stop-color="#F8F4E9" />
      <stop offset="85%" stop-color="#E9F0E7" />
      <stop offset="100%" stop-color="#D9E5D6" />
    </radialGradient>

    <!-- Glass Bottle Shading (Liquid Manjan Amber-Emerald Essence) -->
    <linearGradient id="amberLiquid" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#2D5A3D" />
      <stop offset="25%" stop-color="#417C55" />
      <stop offset="60%" stop-color="#244E34" />
      <stop offset="85%" stop-color="#1B3F29" />
      <stop offset="100%" stop-color="#102B1B" />
    </linearGradient>

    <!-- Glass Reflection Highlighting -->
    <linearGradient id="glassReflect" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.4" />
      <stop offset="20%" stop-color="#FFFFFF" stop-opacity="0.1" />
      <stop offset="70%" stop-color="#FFFFFF" stop-opacity="0" />
      <stop offset="90%" stop-color="#FFFFFF" stop-opacity="0.25" />
      <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0.05" />
    </linearGradient>

    <!-- Metallic Gold Foil -->
    <linearGradient id="goldFoil" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F3E5AB" />
      <stop offset="35%" stop-color="#C7A45B" />
      <stop offset="70%" stop-color="#8C6E2D" />
      <stop offset="100%" stop-color="#E5C778" />
    </linearGradient>

    <!-- Shadow filter -->
    <filter id="softShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="25" stdDeviation="28" flood-color="#103A29" flood-opacity="0.22" />
    </filter>
    <filter id="glowDrop" x="-30%" y="-30%" width="160%" height="160%">
      <feDropShadow dx="0" dy="4" stdDeviation="6" flood-color="#C7A45B" flood-opacity="0.5" />
    </filter>
  </defs>

  <!-- Background Canvas -->
  <rect width="800" height="800" fill="url(#bgGlow)" />

  <!-- Botanical Background Elements (Neem, Babool, Clove Leaves) -->
  <g opacity="0.4">
    <!-- Big Herbal Leaf Left -->
    <path d="M-40 400 C60 300 120 480 220 380 C180 500 80 540 -40 500 Z" fill="#2E6948" />
    <!-- Golden Leaf Outlines -->
    <path d="M720 180 C600 240 640 380 540 460 C640 430 760 360 820 280 Z" fill="#C7A45B" opacity="0.35" />
    <circle cx="680" cy="580" r="140" fill="#E9F0E7" />
  </g>

  <!-- Ground Studio Shadow -->
  <ellipse cx="400" cy="720" rx="190" ry="24" fill="#103A29" opacity="0.18" />
  <ellipse cx="400" cy="718" rx="130" ry="14" fill="#103A29" opacity="0.25" />

  <!-- MAIN PRODUCT: GIWANSALLY LIQUID MANJAN BOTTLE -->
  <g filter="url(#softShadow)">
    
    <!-- Dropper Bulb / Cap (Black Rubber & Metallic Gold Collar) -->
    <!-- Gold Pipette Pipette Collar -->
    <rect x="375" y="150" width="50" height="42" rx="4" fill="url(#goldFoil)" />
    <line x1="375" y1="162" x2="425" y2="162" stroke="#8C6E2D" stroke-width="1.5" />
    <line x1="375" y1="178" x2="425" y2="178" stroke="#F3E5AB" stroke-width="1.5" />

    <!-- Rubber Dropper Teat -->
    <path d="M382 150 C382 110 390 95 400 95 C410 95 418 110 418 150 Z" fill="#1A2B20" />
    <!-- Teat highlight -->
    <path d="M394 105 C397 105 400 112 400 135" stroke="#4A6553" stroke-width="2.5" stroke-linecap="round" />

    <!-- Glass Dropper Pipette Neck -->
    <rect x="360" y="192" width="80" height="26" rx="5" fill="url(#goldFoil)" />
    <!-- Ring Details -->
    <rect x="355" y="214" width="90" height="10" rx="3" fill="url(#goldFoil)" />

    <!-- Glass Bottle Shoulder & Body (Heavy Base Studio Glass Bottle) -->
    <!-- Bottle Shape -->
    <path d="M360 224 C330 240 300 275 295 330 L295 675 C295 695 315 710 340 710 L460 710 C485 710 505 695 505 675 L505 330 C500 275 470 240 440 224 Z" fill="url(#amberLiquid)" />

    <!-- Liquid Level Visual Effect (Liquid Manjan inside showing viscosity & meniscus) -->
    <path d="M302 335 C320 338 480 338 498 335 L498 672 C498 688 480 700 458 700 L342 700 C320 700 302 688 302 672 Z" fill="#17452B" opacity="0.85" />

    <!-- Subtle Golden Particle Glow in Liquid (Ayurvedic Herb Extracts) -->
    <circle cx="340" cy="420" r="3" fill="url(#goldFoil)" opacity="0.6" />
    <circle cx="460" cy="490" r="2" fill="url(#goldFoil)" opacity="0.7" />
    <circle cx="360" cy="620" r="2.5" fill="url(#goldFoil)" opacity="0.5" />
    <circle cx="430" cy="580" r="3.5" fill="url(#goldFoil)" opacity="0.65" />

    <!-- Glass Surface Specular Reflection Overlay -->
    <path d="M360 224 C330 240 300 275 295 330 L295 675 C295 695 315 710 340 710 L460 710 C485 710 505 695 505 675 L505 330 C500 275 470 240 440 224 Z" fill="url(#glassReflect)" />
    <path d="M312 320 L312 670" stroke="#FFFFFF" stroke-width="4" stroke-linecap="round" opacity="0.45" />

    <!-- PREMIUM LABEL (Cream paper with Forest Green & Gold Embossing) -->
    <rect x="315" y="340" width="170" height="295" rx="8" fill="#F8F4E9" stroke="url(#goldFoil)" stroke-width="2" />
    <!-- Inner Gold Filigree Border -->
    <rect x="321" y="346" width="158" height="283" rx="5" fill="none" stroke="url(#goldFoil)" stroke-width="1" stroke-dasharray="4 2" />

    <!-- Brand Header on Label -->
    <!-- Miniature Botanical Emblem -->
    <circle cx="400" cy="376" r="15" fill="#103A29" stroke="url(#goldFoil)" stroke-width="1" />
    <path d="M400 366 C396 371 393 376 393 380 C393 384 396 386 400 386 C404 386 407 384 407 380 C407 376 404 371 400 366 Z" fill="url(#goldFoil)" />

    <text x="400" y="412" font-family="'Cinzel', serif" font-size="16" font-weight="800" fill="#174D35" text-anchor="middle" letter-spacing="2">GIWANSALLY</text>
    
    <line x1="345" y1="422" x2="455" y2="422" stroke="url(#goldFoil)" stroke-width="1" />
    
    <text x="400" y="440" font-family="'Cinzel', serif" font-size="10.5" font-weight="700" fill="#C7A45B" text-anchor="middle" letter-spacing="1.2">AYURVEDIC</text>
    <text x="400" y="456" font-family="'Cinzel', serif" font-size="11.5" font-weight="800" fill="#103A29" text-anchor="middle" letter-spacing="1.5">LIQUID MANJAN</text>

    <!-- Key Ingredients Pill on Label -->
    <rect x="335" y="472" width="130" height="42" rx="4" fill="#E9F0E7" />
    <text x="400" y="488" font-family="'Plus Jakarta Sans', sans-serif" font-size="7.5" font-weight="700" fill="#174D35" text-anchor="middle">CLOVE • BABOOL • BAKUL</text>
    <text x="400" y="504" font-family="'Plus Jakarta Sans', sans-serif" font-size="7" font-weight="600" fill="#C7A45B" text-anchor="middle">MAJUPHAL &amp; VAJRADANTI</text>

    <!-- Net Content & Features -->
    <text x="400" y="534" font-family="'Plus Jakarta Sans', sans-serif" font-size="7.5" font-weight="600" fill="#4B6354" text-anchor="middle">Zero Micro-Abrasion Enamel Care</text>
    <text x="400" y="548" font-family="'Plus Jakarta Sans', sans-serif" font-size="7" font-weight="500" fill="#4B6354" text-anchor="middle">Fresh Breath • Healthy Gums</text>

    <!-- Origin & Volume Tag -->
    <rect x="338" y="566" width="124" height="26" rx="13" fill="#103A29" />
    <text x="368" y="582" font-family="'Cinzel', serif" font-size="9" font-weight="700" fill="#FFFFFF" text-anchor="middle">100 ML</text>
    <line x1="392" y1="570" x2="392" y2="588" stroke="url(#goldFoil)" stroke-width="1" />
    <text x="428" y="582" font-family="'Plus Jakarta Sans', sans-serif" font-size="7.5" font-weight="700" fill="#E5C778" text-anchor="middle">BANDA, UP</text>

    <!-- Base certification seal -->
    <text x="400" y="614" font-family="'Plus Jakarta Sans', sans-serif" font-size="6.5" font-weight="700" fill="#C7A45B" text-anchor="middle" letter-spacing="1">100% PURE HERBAL EXTRACTS</text>
  </g>

  <!-- FLOATING LIQUID MANJAN DROPLETS WITH BOTANICAL ESSENCE -->
  <g filter="url(#glowDrop)">
    <!-- Liquid Manjan Droplet falling from top -->
    <path d="M400 48 C394 62 388 74 388 84 C388 92 393 98 400 98 C407 98 412 92 412 84 C412 74 406 62 400 48 Z" fill="url(#goldFoil)" />
    <!-- Highlight on drop -->
    <circle cx="396" cy="80" r="2.5" fill="#FFFFFF" opacity="0.8" />
  </g>

  <!-- NATURAL HERBAL SUPPORTING VISUALS (Cloves, Cinnamon, Green Leaves) -->
  <!-- Left Side: Fresh Ayurvedic Cloves (Laung) -->
  <g transform="translate(160, 610) rotate(-15)">
    <!-- Clove Head -->
    <ellipse cx="40" cy="40" rx="14" ry="12" fill="#5A3825" stroke="#3D2214" stroke-width="2" />
    <circle cx="40" cy="38" r="9" fill="#75482F" />
    <path d="M32 32 Q40 28 48 32 Q40 44 32 32 Z" fill="#9C6342" />
    <!-- Clove Stem -->
    <path d="M34 50 L30 95 C30 98 46 98 46 95 L44 50 Z" fill="#4A2E1E" />
    <!-- Golden Clove glow -->
    <circle cx="40" cy="38" r="18" fill="url(#goldFoil)" opacity="0.2" />
  </g>

  <g transform="translate(220, 640) rotate(25)">
    <ellipse cx="30" cy="30" rx="12" ry="10" fill="#5A3825" stroke="#3D2214" stroke-width="1.5" />
    <circle cx="30" cy="28" r="7" fill="#75482F" />
    <path d="M26 38 L24 75 C24 77 36 77 36 75 L34 38 Z" fill="#4A2E1E" />
  </g>

  <!-- Right Side: Fresh Green Botanical Leaves (Babool / Neem) -->
  <g transform="translate(560, 580) rotate(20)">
    <!-- Big Leaf -->
    <path d="M0 80 C40 40 80 10 130 0 C110 50 80 100 0 80 Z" fill="#2E7D4E" filter="url(#softShadow)" />
    <path d="M0 80 Q60 45 130 0" stroke="#75C28F" stroke-width="2.5" />
    <!-- Side leaf -->
    <path d="M30 65 C60 50 80 30 110 20 C100 45 70 70 30 65 Z" fill="#3DA167" />
  </g>
  <g transform="translate(520, 640) rotate(-10)">
    <path d="M0 60 C30 30 60 10 100 0 C80 40 60 70 0 60 Z" fill="#23653E" />
  </g>

  <!-- Pure Ayurvedic Badge on studio backdrop -->
  <g transform="translate(620, 140)">
    <circle cx="50" cy="50" r="44" fill="#103A29" stroke="url(#goldFoil)" stroke-width="2" />
    <circle cx="50" cy="50" r="40" fill="none" stroke="url(#goldFoil)" stroke-width="1" stroke-dasharray="3 2" />
    <text x="50" y="42" font-family="'Cinzel', serif" font-size="9" font-weight="700" fill="#C7A45B" text-anchor="middle">AUTHENTIC</text>
    <text x="50" y="55" font-family="'Cinzel', serif" font-size="12" font-weight="800" fill="#FFFFFF" text-anchor="middle">BANDA</text>
    <text x="50" y="67" font-family="'Plus Jakarta Sans', sans-serif" font-size="7" font-weight="600" fill="#E5C778" text-anchor="middle">AYURVEDA</text>
  </g>
</svg>

