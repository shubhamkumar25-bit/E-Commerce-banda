<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800" fill="none">
  <defs>
    <linearGradient id="wallGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FAF7F0" />
      <stop offset="60%" stop-color="#F2EDE2" />
      <stop offset="100%" stop-color="#E5DEC9" />
    </linearGradient>
    <linearGradient id="woodShelf" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#8D6E63" />
      <stop offset="30%" stop-color="#6D4C41" />
      <stop offset="100%" stop-color="#4E342E" />
    </linearGradient>
    <linearGradient id="copperGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFB300" />
      <stop offset="40%" stop-color="#D84315" />
      <stop offset="70%" stop-color="#BF360C" />
      <stop offset="100%" stop-color="#FFAB91" />
    </linearGradient>
    <linearGradient id="goldL" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FCEAB3" />
      <stop offset="50%" stop-color="#C7A45B" />
      <stop offset="100%" stop-color="#8E6E24" />
    </linearGradient>
    <filter id="lifeShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="16" stdDeviation="20" flood-color="#103A29" flood-opacity="0.25" />
    </filter>
  </defs>

  <!-- Ambient Morning Sunlit Bathroom Wall -->
  <rect width="800" height="800" fill="url(#wallGrad)" />

  <!-- Morning Window Sunlight Shaft -->
  <polygon points="100,0 350,0 600,600 250,600" fill="#FFFDE7" opacity="0.35" />

  <!-- Wooden Morning Vanity Shelf -->
  <rect x="0" y="580" width="800" height="40" fill="url(#woodShelf)" />
  <rect x="0" y="620" width="800" height="180" fill="#3E2723" opacity="0.9" />

  <!-- Pure Ayurvedic Copper Tongue Cleaner resting on shelf -->
  <g transform="translate(140, 520) rotate(-15)">
    <!-- U-shaped copper band -->
    <path d="M40 80 Q100 10 160 80 L170 120 L150 120 L140 85 Q100 30 60 85 L50 120 L30 120 Z" fill="url(#copperGrad)" filter="url(#lifeShadow)" />
    <circle cx="100" cy="40" r="4" fill="#FFFFFF" opacity="0.7" />
    <text x="100" y="160" font-family="'Plus Jakarta Sans', sans-serif" font-size="11" font-weight="700" fill="#D7CCC8" text-anchor="middle">Pure Copper Cleaner</text>
  </g>

  <!-- GIWANSALLY Liquid Manjan Bottle in Center -->
  <g transform="translate(360, 240) scale(0.95)" filter="url(#lifeShadow)">
    <!-- Dropper -->
    <path d="M80 60 C80 30 88 15 96 15 C104 15 112 30 112 60 Z" fill="#15261C" />
    <rect x="74" y="60" width="44" height="35" rx="3" fill="url(#goldL)" />
    <rect x="62" y="95" width="68" height="20" rx="3" fill="url(#goldL)" />
    <!-- Glass Bottle -->
    <path d="M62 115 C34 130 10 165 6 210 L6 450 C6 470 22 482 46 482 L146 482 C170 482 186 470 186 450 L186 210 C182 165 158 130 130 115 Z" fill="#17482F" />
    <!-- Label -->
    <rect x="22" y="200" width="148" height="240" rx="6" fill="#FBF8F1" stroke="url(#goldL)" stroke-width="2" />
    <text x="96" y="246" font-family="'Cinzel', serif" font-size="14" font-weight="800" fill="#174D35" text-anchor="middle">GIWANSALLY</text>
    <text x="96" y="264" font-family="'Plus Jakarta Sans', sans-serif" font-size="7" font-weight="700" fill="#C7A45B" text-anchor="middle">LIQUID MANJAN</text>
    <text x="96" y="320" font-family="'Cinzel', serif" font-size="10" font-weight="700" fill="#103A29" text-anchor="middle">BANDA, UP</text>
    <text x="96" y="345" font-family="'Plus Jakarta Sans', sans-serif" font-size="7.5" font-weight="600" fill="#4B6354" text-anchor="middle">Daily Dinacharya Ritual</text>
  </g>

  <!-- Small Ceramic Bowl with Water & Flower Petal on right -->
  <g transform="translate(600, 530)">
    <ellipse cx="60" cy="50" rx="55" ry="18" fill="#ECEFF1" stroke="#CFD8DC" stroke-width="2" />
    <ellipse cx="60" cy="48" rx="48" ry="14" fill="#B0BEC5" opacity="0.5" />
    <!-- Jasmine Petal -->
    <ellipse cx="60" cy="46" rx="12" ry="8" fill="#FFFDE7" />
  </g>

  <text x="400" y="740" font-family="'Cinzel', serif" font-size="14" font-weight="700" fill="#FFFFFF" text-anchor="middle" letter-spacing="2">AUTHENTIC AYURVEDIC MORNING RITUAL</text>
</svg>

