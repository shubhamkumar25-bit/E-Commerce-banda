<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800" fill="none">
  <defs>
    <radialGradient id="careBg" cx="50%" cy="50%" r="55%">
      <stop offset="0%" stop-color="#FFFFFF" />
      <stop offset="50%" stop-color="#F2EFE6" />
      <stop offset="100%" stop-color="#D9E6D6" />
    </radialGradient>
    <linearGradient id="goldHOC" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFE082" />
      <stop offset="40%" stop-color="#C7A45B" />
      <stop offset="100%" stop-color="#8D6E26" />
    </linearGradient>
  </defs>

  <rect width="800" height="800" fill="url(#careBg)" />
  <circle cx="400" cy="400" r="300" fill="#E8F0E6" stroke="url(#goldHOC)" stroke-width="2" stroke-dasharray="8 4" />

  <!-- Botanical Emblem Center -->
  <g transform="translate(400, 360)">
    <!-- Liquid Manjan Droplet surrounded by sacred leaf ring -->
    <circle cx="0" cy="0" r="120" fill="#174D35" />
    <path d="M0 -60 C-35 0 -50 35 -50 70 C-50 100 -25 125 0 125 C25 125 50 100 50 70 C50 35 35 0 0 -60 Z" fill="url(#goldHOC)" />
    <!-- Leaf veins -->
    <path d="M0 -30 L0 100" stroke="#103A29" stroke-width="2.5" stroke-linecap="round" />
  </g>

  <!-- Surrounding Ayurvedic Herb Badges -->
  <g transform="translate(400, 150)">
    <rect x="-80" y="-18" width="160" height="36" rx="18" fill="#FFFFFF" stroke="#C7A45B" stroke-width="1.5" />
    <text x="0" y="5" font-family="'Plus Jakarta Sans', sans-serif" font-size="11" font-weight="700" fill="#174D35" text-anchor="middle">🌿 Babool (Acacia)</text>
  </g>
  <g transform="translate(190, 400)">
    <rect x="-80" y="-18" width="160" height="36" rx="18" fill="#FFFFFF" stroke="#C7A45B" stroke-width="1.5" />
    <text x="0" y="5" font-family="'Plus Jakarta Sans', sans-serif" font-size="11" font-weight="700" fill="#174D35" text-anchor="middle">🌱 Clove (Laung)</text>
  </g>
  <g transform="translate(610, 400)">
    <rect x="-80" y="-18" width="160" height="36" rx="18" fill="#FFFFFF" stroke="#C7A45B" stroke-width="1.5" />
    <text x="0" y="5" font-family="'Plus Jakarta Sans', sans-serif" font-size="11" font-weight="700" fill="#174D35" text-anchor="middle">💎 Vajradanti</text>
  </g>
  <g transform="translate(400, 650)">
    <rect x="-80" y="-18" width="160" height="36" rx="18" fill="#FFFFFF" stroke="#C7A45B" stroke-width="1.5" />
    <text x="0" y="5" font-family="'Plus Jakarta Sans', sans-serif" font-size="11" font-weight="700" fill="#174D35" text-anchor="middle">🍃 Pudina Satva</text>
  </g>

  <text x="400" y="530" font-family="'Cinzel', serif" font-size="20" font-weight="800" fill="#103A29" text-anchor="middle" letter-spacing="2">HERBAL ORAL CARE</text>
  <text x="400" y="555" font-family="'Plus Jakarta Sans', sans-serif" font-size="11" font-weight="600" fill="#C7A45B" text-anchor="middle">100% PURE BOTANICAL DEFENSE</text>
</svg>

